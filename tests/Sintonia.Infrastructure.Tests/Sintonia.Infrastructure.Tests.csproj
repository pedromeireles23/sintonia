<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../../tools/Sintonia.Diagnostics/ClaudeToolPermissionProbe.cs" Link="Diagnostics/ClaudeToolPermissionProbe.cs" />
    <Compile Include="../../tools/Sintonia.Diagnostics/ClaudeMcpPermissionProbe.cs" Link="Diagnostics/ClaudeMcpPermissionProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sintonia.Infrastructure\Sintonia.Infrastructure.csproj" />
    <ProjectReference Include="../Sintonia.ProcessFixture/Sintonia.ProcessFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyProcessFixture" AfterTargets="Build">
    <MSBuild Projects="../Sintonia.ProcessFixture/Sintonia.ProcessFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureTarget" />
    </MSBuild>
    <ItemGroup>
      <FixtureFiles Include="%(FixtureTarget.RootDir)%(FixtureTarget.Directory)Sintonia.ProcessFixture.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)fixtures" />
  </Target>

</Project>
