<Window x:Class="Sintonia.Desktop.TaskQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Fila de tarefas" Width="1200" Height="900" MinWidth="1050" MinHeight="760"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
    <Border Background="#F4F7F4" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Fila de tarefas" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Project.Name}" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Project.Directory}" Style="{StaticResource Caption}" Margin="0,3,0,10" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Planos aprovados disponíveis" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding ApprovedProposals}" SelectedItem="{Binding SelectedProposal}" DisplayMemberPath="Definition.Title" IsEnabled="{Binding CanChoose}" Padding="8" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Encaminhar à fila" Command="{Binding EnqueueCommand}" Margin="10,18,0,0" AutomationProperties.AutomationId="EnqueuePlan" />
                <Button Grid.Column="2" Content="Atualizar" Command="{Binding ReloadCommand}" Margin="10,18,0,0" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Plano encaminhado" FontWeight="SemiBold" />
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Definition.Title" IsEnabled="{Binding CanChoose}" Padding="7" Margin="0,8,0,12" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" IsEnabled="{Binding CanChoose}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="QueueTasks">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TabControl x:Name="TaskTabs">
                        <TabItem Header="Entrega">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Text="{Binding TaskDetails}" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding Session.Messages}">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><StackPanel>
                                            <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="0,3,0,6" />
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" />
                                        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Tentativas">
                            <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <ComboBox ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt}" DisplayMemberPath="Label" IsEnabled="{Binding CanChoose}" Padding="7" />
                                <TextBlock Grid.Row="1" Text="{Binding SelectedAttempt.Run.Error}" Style="{StaticResource Caption}" Margin="0,8,0,8" />
                                <TextBox Grid.Row="2" Text="{Binding HistoricalResponse, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Atividade"><ListBox ItemsSource="{Binding Session.Events}" BorderThickness="0" Margin="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                        <TabItem Header="Pasta de trabalho" AutomationProperties.AutomationId="TaskWorktreeTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Text="Pasta da tarefa" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Button Content="Preparar worktree" Command="{Binding PrepareWorktreeCommand}" AutomationProperties.AutomationId="PrepareTaskWorktree" />
                                        <Button Content="Revisar diffs" Click="OpenDiffs" IsEnabled="{Binding CanReviewDiffs}" Margin="8,0,0,0" AutomationProperties.AutomationId="OpenTaskDiffs" />
                                    </StackPanel>
                                    <TextBox Text="{Binding WorktreeDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="TaskWorktreeDetails" />
                                    <TextBlock Text="{Binding WorktreeExplanation}" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Background="#FFF4DA" Padding="10" Margin="0,10,0,0" Visibility="{Binding Workspace.HasPermission, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Ação aguardando autorização" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Workspace.Permission.Provider}" Foreground="{StaticResource Accent}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Workspace.Permission.WorkingDirectory}" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding Workspace.Permission.Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,5,0,7" />
                            <StackPanel Orientation="Horizontal"><Button Content="Permitir esta ação" Command="{Binding Workspace.AllowPermissionCommand}" /><Button Content="Recusar" Command="{Binding Workspace.DenyPermissionCommand}" Margin="8,0,0,0" /></StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Iniciar tarefas disponíveis" Command="{Binding StartAvailableCommand}" AutomationProperties.AutomationId="StartAvailableTasks" />
                    <TextBlock Text="{Binding SessionUsage}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </WrapPanel>
                <ScrollViewer MaxHeight="52" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding TaskStatus}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /></ScrollViewer>
                <TextBlock Text="Nota da revisão / ajuste solicitado" Style="{StaticResource Caption}" Margin="0,6,0,4" />
                <TextBox Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReview}" TextWrapping="Wrap" AcceptsReturn="True" Height="52" MaxLength="4000" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.AutomationId="TaskReviewNote" />
                <DockPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Iniciar tentativa" Command="{Binding StartCommand}" AutomationProperties.AutomationId="StartQueueTask" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                        <Button Content="Solicitar ajustes" Command="{Binding RequestChangesCommand}" Margin="8,0,0,0" />
                        <Button Content="Aprovar entrega" Command="{Binding ApproveCommand}" Background="{StaticResource Accent}" Foreground="White" Margin="8,0,0,0" AutomationProperties.AutomationId="ApproveDelivery" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer MaxHeight="44" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" /></ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</Window>
