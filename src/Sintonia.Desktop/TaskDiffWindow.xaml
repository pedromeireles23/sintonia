<Window x:Class="Sintonia.Desktop.TaskDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Diffs da tarefa" Width="1280" Height="880" MinWidth="1050" MinHeight="760"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Border Background="#F4F7F4" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Diffs da tarefa" FontSize="26" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><TextBlock Text="{Binding Context}" Style="{StaticResource Caption}" /></ScrollViewer>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <ScrollViewer x:Name="DiffSummaryScroll" MaxHeight="130" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DeliveryStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding PreparationStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                             Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" AutomationProperties.AutomationId="TaskCombinationStatus" />
                </StackPanel></ScrollViewer>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="350" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Arquivos da worktree" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ListBox x:Name="DiffFiles" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" IsEnabled="{Binding CanChoose}"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="TaskDiffFiles">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding PreviousPath}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedFile.Path}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button Content="Ler novamente" DockPanel.Dock="Right" Command="{Binding ReadCommand}" Margin="10,0,0,0" Padding="12,8" />
                            <ComboBox x:Name="DiffComparison" ItemsSource="{Binding Comparisons}" SelectedItem="{Binding Comparison}" DisplayMemberPath="Name" IsEnabled="{Binding CanChoose}" Padding="7" AutomationProperties.AutomationId="TaskDiffComparison" />
                        </DockPanel>
                        <TextBlock Grid.Row="2" Text="{Binding ContentStatus}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                        <TextBox x:Name="DiffContent" Grid.Row="3" Text="{Binding ContentText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFCFA" BorderThickness="0" Padding="8" AutomationProperties.AutomationId="TaskDiffContent" />
                    </Grid>
                </Border>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="A consulta inclui toda a worktree, inclusive fora da subpasta do projeto. Atualize após mudanças. Registrar um commit conserva sua identificação; aprovação e integração são etapas separadas." Style="{StaticResource Caption}" />
                <ScrollViewer MaxHeight="44" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10"><TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" /></ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Registrar commit revisado" Command="{Binding RegisterCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="RegisterTaskDelivery" />
                    <Button Content="Preparar combinação" Command="{Binding PrepareCombinationCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="PrepareTaskCombination" />
                    <Button Content="Validar combinação" Click="OpenValidation" IsEnabled="{Binding CanValidateCombination}" Margin="0,0,8,0" AutomationProperties.AutomationId="OpenTaskValidation" />
                    <Button Content="Cancelar operação" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="Atualizar diffs" Command="{Binding RefreshCommand}" Background="{StaticResource Accent}" Foreground="White" AutomationProperties.AutomationId="RefreshTaskDiffs" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
