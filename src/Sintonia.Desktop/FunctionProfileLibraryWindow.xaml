<Window x:Class="Sintonia.Desktop.FunctionProfileLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Perfis de função" Width="1100" Height="820" MinWidth="900" MinHeight="680"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Border Background="#F4F7F4" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Perfis de função" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Reutilize funções, provedores, modelos e instruções entre seus projetos." Style="{StaticResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Biblioteca local" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanChoose}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FunctionProfiles">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding FunctionName}" Style="{StaticResource Caption}" Margin="0,5,0,0" /><TextBlock Text="{Binding Provider}" Foreground="{StaticResource Accent}" Margin="0,4,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Content="Novo perfil" Command="{Binding NewCommand}" AutomationProperties.AutomationId="NewFunctionProfile" />
                            <Button Content="Atualizar lista" Command="{Binding ReloadCommand}" Margin="0,8,0,0" />
                            <Button Content="Excluir perfil" Command="{Binding DeleteCommand}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="Nome do perfil" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,5,0,14" MaxLength="80" AutomationProperties.AutomationId="FunctionProfileName" />
                            <TextBlock Text="Função" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding FunctionNames}" Text="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="7" Margin="0,5,0,14" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Provedor padrão" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" Padding="7" Margin="0,5,0,14" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Modelo padrão (opcional)" FontWeight="SemiBold" /><TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Padding="8" Margin="0,5,0,14" AutomationProperties.AutomationId="FunctionProfileModel" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Vazio usa o padrão da instalação. O provedor confirma disponibilidade e acesso ao enviar." Style="{StaticResource Caption}" Margin="0,0,0,14" />
                            <TextBlock Text="Instruções adicionais" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="210" MaxLength="{Binding InstructionLimit}" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,5,0,8" AutomationProperties.AutomationId="FunctionProfileInstructions" />
                            <TextBlock Text="{Binding InstructionHint}" Style="{StaticResource Caption}" />
                            <TextBlock Text="O perfil preenche uma nova conversa em leitura. Alterar ou excluir este perfil preserva sessões e tarefas já criadas. Permissões de ferramentas continuam sob as regras do provedor." Style="{StaticResource Caption}" Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="{Binding State}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" Margin="0,5,0,10"><TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" /></ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reverter alterações" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                    <Button Content="Salvar perfil" Command="{Binding SaveCommand}" Background="{StaticResource Accent}" Foreground="White" AutomationProperties.AutomationId="SaveFunctionProfile" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
