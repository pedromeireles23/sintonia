<Window x:Class="Sintonia.Desktop.ProposalReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Revisão de planos" Width="1100" Height="900" MinWidth="900" MinHeight="700"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5,0,12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,5,0,12" /></Style>
    </Window.Resources>
    <Border Background="#F4F7F4" Padding="22">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Revisar plano do projeto" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Project.Name}" Foreground="{StaticResource Accent}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding Project.Directory}" Style="{StaticResource Caption}" Margin="0,3,0,12" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" DisplayMemberPath="Definition.Title" IsEnabled="{Binding CanChooseProposal}" AutomationProperties.AutomationId="Proposals" />
            <Button Grid.Column="1" Content="Atualizar lista" Command="{Binding ReloadCommand}" Margin="12,5,0,12" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Tarefas propostas" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" IsEnabled="{Binding CanSelectTask}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ProposedTasks">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Provider}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Adicionar tarefa" Command="{Binding AddTaskCommand}" />
                        <Button Content="Remover tarefa" Command="{Binding RemoveTaskCommand}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ProposalFields">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Título do plano" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.AutomationId="PlanTitle" />
                        <TextBlock Text="Objetivo" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Objective, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" MaxLength="8000" VerticalScrollBarVisibility="Auto" />
                        <Separator Margin="0,0,0,14" />
                        <TextBlock Text="{Binding SelectedTask.Id}" Style="{StaticResource Caption}" />
                        <TextBlock Text="Título da tarefa" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBox Text="{Binding SelectedTask.Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.AutomationId="TaskTitle" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Função" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedTask.FunctionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Acesso recomendado" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding AccessOptions}" SelectedItem="{Binding SelectedTask.Access}" DisplayMemberPath="Name" /></StackPanel>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Responsável" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedTask.Provider}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Modelo (opcional)" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedTask.Model, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="Vazio usa o padrão da instalação. Disponibilidade será conferida ao executar." /></StackPanel>
                        </Grid>
                        <TextBlock Text="Instruções da entrega" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedTask.Instructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" MaxLength="8000" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Escopo — um caminho relativo por linha" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedTask.Scope, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" MaxLength="3000" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Dependências — IDs separados por vírgula" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedTask.Dependencies, UpdateSourceTrigger=PropertyChanged}" MaxLength="680" AutomationProperties.AutomationId="TaskDependencies" />
                        <TextBlock Text="Critérios de entrega — um por linha" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedTask.AcceptanceCriteria, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" MaxLength="8100" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding State}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,5,0,12" AutomationProperties.AutomationId="ProposalNotice" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Validar plano" Command="{Binding ValidateCommand}" Margin="0,0,8,0" />
                <Button Content="Reverter alterações" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                <Button Content="Salvar rascunho" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" />
                <Button Content="Confirmar plano" Command="{Binding ApproveCommand}" Background="{StaticResource Accent}" Foreground="White" AutomationProperties.AutomationId="ApprovePlan" />
            </StackPanel>
        </StackPanel>
    </Grid>
    </Border>
</Window>
