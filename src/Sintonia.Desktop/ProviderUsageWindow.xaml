<Window x:Class="Sintonia.Desktop.ProviderUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Uso dos provedores" Width="820" Height="780" MinWidth="680" MinHeight="660"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
    <Border Background="#F4F7F4" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Uso dos provedores" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Dados da conta, compartilhados entre projetos e aplicativos." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" IsEnabled="{Binding CanConfigure}" Padding="8" HorizontalAlignment="Left" Width="160" AutomationProperties.AutomationId="UsageProvider"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" AutomationProperties.AutomationId="UsageStatus"/>
                    <TextBlock Text="{Binding CheckedAt}" Style="{StaticResource Caption}" Margin="0,6,0,10"/>
                    <TextBlock Text="{Binding Allowance}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding WindowNotice}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Buckets}" AutomationProperties.AutomationId="UsageBuckets">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,6,0,12">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Percentages}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Height="8" Foreground="{StaticResource Accent}" Visibility="{Binding HasData, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Duration}" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding Reset}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="A consulta não garante acesso futuro. Percentuais e horários de renovação não autorizam novos envios nem representam saldo em dinheiro. Atualize para acompanhar mudanças." Style="{StaticResource Caption}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="76" Margin="0,8,0,12"><TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" AutomationProperties.AutomationId="UsageNotice"/></ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar consulta" Command="{Binding CancelCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelProviderUsage"/>
                    <Button Content="Atualizar uso" Command="{Binding RefreshCommand}" Background="{StaticResource Accent}" Foreground="White" AutomationProperties.AutomationId="RefreshProviderUsage"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
