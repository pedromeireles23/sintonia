<Window x:Class="Sintonia.Desktop.GitDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Diagnóstico Git" Width="1100" Height="820" MinWidth="900" MinHeight="760"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
    <Border Background="#F4F7F4" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Diagnóstico Git" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Project.Name}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="{Binding Project.Directory}" Style="{StaticResource Caption}" MaxHeight="38" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusTitle}" FontSize="18" Foreground="{StaticResource Accent}" FontWeight="SemiBold" AutomationProperties.AutomationId="GitStatus" />
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Raiz do repositório" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding RootDirectory}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Branch" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Branch}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="Commit atual" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HeadCommit}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="Acompanhamento" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Upstream}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Text="Consultado em" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CheckedAt}" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Alterações locais" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding ChangeSummary}" Style="{StaticResource Caption}" Margin="0,5,0,10" />
                    <DataGrid x:Name="ChangedFiles" Grid.Row="2" ItemsSource="{Binding Changes}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeaderWidth="0" AutomationProperties.AutomationId="GitChanges">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Caminho relativo à raiz" Width="*" MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6,8">
                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviousPath}" Style="{StaticResource Caption}" Visibility="{Binding HasPreviousPath, Converter={StaticResource BoolVisibility}}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding SubmoduleText}" Style="{StaticResource Caption}" Visibility="{Binding IsSubmodule, Converter={StaticResource BoolVisibility}}" Margin="0,5,0,0" />
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Preparado para commit" Binding="{Binding IndexText}" Width="170" />
                            <DataGridTextColumn Header="Na pasta" Binding="{Binding WorktreeText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="Consulta local em leitura. Confira a raiz: uma subpasta mostra alterações de todo o repositório. Atualize após mudanças no projeto. Projetos sem Git continuam disponíveis." Style="{StaticResource Caption}" />
                <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10"><TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" /></ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar consulta" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="Atualizar diagnóstico" Command="{Binding RefreshCommand}" Background="{StaticResource Accent}" Foreground="White" AutomationProperties.AutomationId="RefreshGitDiagnostics" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
