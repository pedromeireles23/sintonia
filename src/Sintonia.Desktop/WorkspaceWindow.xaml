<Window x:Class="Sintonia.Desktop.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Central de projetos" Width="1450" Height="950" MinWidth="1120" MinHeight="760"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
    <Grid Background="#F4F7F4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
        <Border Background="#173C2C" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="sintonia" Foreground="White" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Sua central de projetos" Foreground="#A8C6B6" Margin="0,6,0,28" />
                    <TextBlock Text="PROJETOS" Foreground="#A8C6B6" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Row="1" Content="+ Adicionar projeto" Command="{Binding AddProjectCommand}" Margin="0,12,0,18" AutomationProperties.AutomationId="AddProject" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}"
                         Foreground="White" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Projects">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Directory}" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3">
                    <TextBlock Foreground="#A8C6B6" Margin="0,0,0,14"><Run Text="{Binding ActiveCount, Mode=OneWay}" /><Run Text=" conversas executando" /></TextBlock>
                    <TextBlock Text="Logins por assinatura" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="Codex e Claude Code instalados nesta máquina." Foreground="#A8C6B6" FontSize="12" Margin="0,4,0,18" />
                    <Button Content="Revisar planos" Click="OpenProposals" IsEnabled="{Binding CanReviewProposals}" Margin="0,0,0,8" AutomationProperties.AutomationId="ReviewPlans" />
                    <Button Content="Fila de tarefas" Click="OpenTasks" IsEnabled="{Binding CanReviewProposals}" Margin="0,0,0,8" AutomationProperties.AutomationId="TaskQueue" />
                    <Button Content="Perfis de função" Click="OpenFunctionProfiles" IsEnabled="{Binding CanManageFunctionProfiles}" Margin="0,0,0,8" AutomationProperties.AutomationId="ManageFunctionProfiles" />
                    <Button Content="Diagnóstico Git" Click="OpenGitDiagnostics" IsEnabled="{Binding CanReviewProposals}" Margin="0,0,0,8" AutomationProperties.AutomationId="GitDiagnostics" />
                    <Button Content="Abrir demonstração" Click="OpenDemo" Background="#2D5642" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24,22,18,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ProjectName}" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProjectPath}" Style="{StaticResource Caption}" Margin="0,5,0,18" MaxHeight="38" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" IsEnabled="{Binding CanConfigure}" Padding="8" Margin="0,0,10,0" AutomationProperties.AutomationId="Provider" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding CanConfigure}" Padding="8" AutomationProperties.AutomationId="Model" />
                <Button Grid.Column="2" Content="Modelos" Command="{Binding RefreshModelsCommand}" Margin="10,0,0,0" ToolTip="Consultar opções da instalação. O provedor confirma o acesso ao enviar." />
                <Button Grid.Column="3" Content="Nova conversa" Command="{Binding NewConversationCommand}" Margin="10,0,0,0" AutomationProperties.AutomationId="NewConversation" />
            </Grid>
            <Expander Grid.Row="2" Header="Função e permissões" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding FunctionProfiles}" SelectedItem="{Binding SelectedFunctionProfile}" DisplayMemberPath="Name" IsEnabled="{Binding CanManageFunctionProfiles}" Padding="7" Margin="0,0,10,0" ToolTip="Escolha um perfil da biblioteca local." AutomationProperties.AutomationId="SavedFunctionProfiles" />
                            <Button Grid.Column="1" Content="Nova com perfil" Command="{Binding ApplyFunctionProfileCommand}" ToolTip="Aplicar o perfil a uma nova conversa em leitura, preservando a conversa atual." AutomationProperties.AutomationId="ApplyFunctionProfile" />
                        </Grid>
                        <StackPanel IsEnabled="{Binding CanEditFunction}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Functions}" SelectedItem="{Binding Function}" DisplayMemberPath="Name" Padding="7" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AccessOptions}" SelectedItem="{Binding Access}" DisplayMemberPath="Name" Padding="7" IsEnabled="{Binding CanEditAccess}" />
                            </Grid>
                            <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="8000" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Padding="8" />
                            <TextBlock Text="Chefia propõe tarefas para revisão. Codex e Claude podem pedir autorização por ação neste painel. Regras e hooks da instalação continuam aplicáveis." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding ConversationTitle}" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="ChatScroll">
                        <ItemsControl ItemsSource="{Binding Messages}" AutomationProperties.AutomationId="Messages">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#F4F7F4" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel><TextBlock Text="{Binding State}" DockPanel.Dock="Right" Style="{StaticResource Caption}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /></DockPanel>
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" Foreground="{StaticResource Ink}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Row="4" Margin="0,12,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="160" VerticalScrollBarVisibility="Auto" Padding="12" MaxLength="200000" AutomationProperties.AutomationId="Prompt" ToolTip="Escreva um pedido para a IA. Use Enviar para iniciar." />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Content="Enviar" Command="{Binding SendCommand}" Background="{StaticResource Accent}" Foreground="White" AutomationProperties.AutomationId="SendMessage" />
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,7,0,0" AutomationProperties.AutomationId="CancelConversation" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="5" Text="{Binding Notice}" Style="{StaticResource Caption}" MaxHeight="52" AutomationProperties.AutomationId="Notice" />
        </Grid>
        <Grid Grid.Column="2" Margin="0,22,18,18">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="210" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Conversas e sessões" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Grid.Row="1" Text="Selecione para abrir e continuar." Style="{StaticResource Caption}" Margin="0,6,0,12" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Conversations">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,12" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding State}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Background="#FFF4DA" Padding="12" Margin="0,12,0,0" Visibility="{Binding HasPermission, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="Ação aguardando autorização" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Permission.Provider}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Permission.WorkingDirectory}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Permission.Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10" />
                    <Button Content="Permitir esta ação" Command="{Binding AllowPermissionCommand}" />
                    <Button Content="Recusar" Command="{Binding DenyPermissionCommand}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Atividade da conversa" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" BorderThickness="0" Foreground="{StaticResource Muted}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
