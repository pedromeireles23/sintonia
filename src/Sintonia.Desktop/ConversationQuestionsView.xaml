<UserControl x:Class="Sintonia.Desktop.ConversationQuestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxHeight="390">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="QuestionVisibility" />
        <DataTemplate x:Key="ChoiceContent">
            <StackPanel>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"
                         Visibility="{Binding HasPreview, Converter={StaticResource QuestionVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SingleChoice">
            <RadioButton GroupName="{Binding Group}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                         Content="{Binding}" ContentTemplate="{StaticResource ChoiceContent}" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate x:Key="MultipleChoice">
            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                      Content="{Binding}" ContentTemplate="{StaticResource ChoiceContent}" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Background="#EDF5FF" Padding="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Claude aguarda sua resposta" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Context}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding WorkingDirectory}" Style="{StaticResource Caption}" Margin="0,4,0,8" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsActive}">
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding Header}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,6" />
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" />
                            <ItemsControl ItemsSource="{Binding Choices}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                                        <ContentControl.Style><Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SingleChoice}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding MultiSelect}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource MultipleChoice}" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Outra resposta" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="90" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Content="Enviar respostas" Command="{Binding SubmitCommand}" AutomationProperties.AutomationId="SubmitClaudeQuestions" />
                <Button Content="Recusar perguntas" Command="{Binding DeclineCommand}" Margin="0,6,0,0" AutomationProperties.AutomationId="DeclineClaudeQuestions" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
