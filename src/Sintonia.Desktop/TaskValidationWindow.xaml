<Window x:Class="Sintonia.Desktop.TaskValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintonia — Validação da combinação" Width="1250" Height="840" MinWidth="950" MinHeight="650"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterOwner">
    <Border Background="#F4F7F4" Padding="22"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock Text="Validação da combinação" FontSize="26" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><TextBox Text="{Binding Context, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"/></ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0"><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" IsEnabled="{Binding CanChoose}" AutomationProperties.AutomationId="ValidationHistory"/></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12"><TextBox x:Name="ValidationDetails" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ValidationLogs"/></Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
            <TextBlock Text="Os registros identificam a árvore e a revisão dos critérios. Confira os resultados antes de integrar a entrega." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
            <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"><TextBox Text="{Binding PublicationStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"/></ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Atualizar histórico" Command="{Binding ReloadCommand}"/><Button Content="Cancelar e aguardar" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                <Button Content="Conferir e validar" Command="{Binding ValidateCommand}" Background="{StaticResource Accent}" Foreground="White" Margin="8,0,0,0" AutomationProperties.AutomationId="ValidateTaskCombination"/>
                <Button Content="Publicar no projeto" Command="{Binding PublishCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="PublishTaskCombination"/>
            </StackPanel>
        </StackPanel>
    </Grid></Border>
</Window>
